{
  "name": "@otkritka/cms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./src/payload.config.ts",
    "./seo/paths": "./src/seo/paths.ts",
    "./types": "./src/payload-types.ts"
  },
  "scripts": {
    "audit:links": "payload run ./scripts/run-link-audit.ts",
    "audit:links:scheduled": "payload jobs:run --handle-schedules --queue seo-audit",
    "build": "next build",
    "cards:index:apply": "payload run ./scripts/open-category.ts -- --apply",
    "cards:index:report": "payload run ./scripts/open-category.ts --",
    "check": "tsc --noEmit && tsc --noEmit -p ../../tests/api/tsconfig.json",
    "content:import:apply": "payload run ./scripts/import-pilot-content.ts -- --apply",
    "content:import:dry-run": "payload run ./scripts/import-pilot-content.ts -- --dry-run",
    "content:library:apply": "payload run ./scripts/import-generated-library.ts -- --apply",
    "content:library:dry-run": "payload run ./scripts/import-generated-library.ts -- --dry-run",
    "content:upcoming:apply": "payload run ./scripts/import-generated-library.ts -- --campaign upcoming-holidays-2026-09 --apply",
    "content:upcoming:dry-run": "payload run ./scripts/import-generated-library.ts -- --campaign upcoming-holidays-2026-09 --dry-run",
    "dev": "next dev --port 3011",
    "ensure-db": "node scripts/ensure-database.mjs",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "images:s3:apply": "tsx scripts/sync-images-to-s3.ts --apply",
    "images:s3:check": "tsx scripts/sync-images-to-s3.ts --check",
    "images:s3:dry-run": "tsx scripts/sync-images-to-s3.ts --dry-run",
    "migrate": "payload migrate",
    "migrate:check": "node scripts/migrate-create.mjs --check",
    "migrate:create": "node scripts/migrate-create.mjs",
    "migrate:status": "payload migrate:status",
    "start": "next start --port 3011"
  },
  "dependencies": {
    "@otkritka/images": "workspace:*",
    "@otkritka/shared": "workspace:*",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "graphql": "^16.14.2",
    "next": "^16.3.2",
    "payload": "3.88.0",
    "pg": "8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
