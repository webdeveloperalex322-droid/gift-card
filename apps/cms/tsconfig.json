{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next.js компилирует приложение сам, поэтому здесь только проверка типов.
    // Composite-проектом apps/cms быть не может: composite требует emit
    // объявлений, а Next требует noEmit — поэтому в решении tsconfig.json корня
    // этот проект не ссылается, а проверяется отдельной командой
    // `pnpm --filter @otkritka/cms run check` (входит в корневой `pnpm check`).
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "noEmit": true,
    "tsBuildInfoFile": ".next/tsconfig.tsbuildinfo",

    // Значения, обязательные для Next.js App Router.
    "allowJs": true,
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "plugins": [{ "name": "next" }],

    "types": ["node"],

    // Псевдоним, по которому Payload и его маршруты находят конфиг.
    "paths": {
      "@payload-config": ["./src/payload.config.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "next.config.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mjs",
    "src/**/*.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
