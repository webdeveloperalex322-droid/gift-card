{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Node-часть apps/web: входной сервер и чистые модули маршрутизации.
  //
  // Зачем отдельный проект рядом с `tsconfig.json`. Основной конфиг apps/web —
  // пресет Astro: `moduleResolution: "Bundler"`, `noEmit`, разрешение `.astro`.
  // Он подходит шаблонам, но не файлам, которые ЗАПУСКАЕТ Node: у них другое
  // разрешение модулей (`NodeNext`, расширение в относительном импорте
  // обязательно) и им нужен настоящий emit — из `src/server/entry.mts` получается
  // `dist/server/entry.mjs`, точка входа собранного сервера.
  //
  // Раньше эти же файлы проверял проект тестов (`tests/tsconfig.json`) — то есть
  // владельцем проверки типов кода apps/web был чужой проект, причём под
  // NodeNext, тогда как `astro check` смотрел на них под Bundler. Расхождение
  // разрешено здесь: проверку и emit своей Node-части apps/web делает сам,
  // проект тестов на него ссылается, а требование «относительные импорты только
  // с `.js`» записано в шапке `src/routing/path-policy.ts`.
  //
  // Граница узкая намеренно: сюда попадают только модули БЕЗ импортов `.astro` и
  // без рантайма Astro. `src/middleware.ts` в проект не входит — он импортирует
  // типы пакета `astro` и живёт внутри сборки Astro; его проверяет `astro check`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Emit идёт в тот же `dist`, куда собирает Astro: так `dist/server/entry.mjs`
    // оказывается рядом с `dist/server/astro-app.mjs`, а `dist/client` находится
    // относительным путём `../client/` и при переносе каталога `dist` целиком.
    // Порядок в скрипте `build` поэтому значим: сначала `astro build` (он чистит
    // `dist`), потом этот проект.
    "outDir": "dist",
    // Файл состояния инкрементальной сборки обязан лежать ВНУТРИ `dist`, а не
    // рядом с конфигом (место по умолчанию). Иначе `astro build` вычищает
    // выходные файлы, состояние остаётся, и следующий `tsc -b` докладывает «всё
    // актуально», не восстановив `dist/server/entry.mjs` — сборка выглядит
    // успешной, а сервера в артефакте нет. Ровно это и произошло при первом
    // прогоне.
    "tsBuildInfoFile": "dist/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/routing/**/*.ts", "src/server/**/*.ts", "src/server/**/*.mts", "src/server-env.ts"],
  // `packages/images` добавлен вместе с отдачей `/media/...` (Э2-04b): контракт
  // публичного пути, формы ключа и заголовков кеширования живёт там
  // (`@otkritka/images/media`), а входной сервер обязан звать его, а не
  // переписывать своей строкой.
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/images" }]
}
