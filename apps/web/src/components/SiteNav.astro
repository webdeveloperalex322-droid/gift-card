---
/**
 * Главное меню сайта (задача Э3-08).
 *
 * Печатается на КАЖДОЙ странице — из `../layouts/BaseLayout.astro`, а не из
 * шаблонов страниц. Причина не в удобстве: требование «страница входит в
 * навигацию» — одно из условий п. 5.1 ТЗ, и его нельзя выполнять по одному
 * шаблону из пяти. Пункт, добавленный в layout, появляется сразу везде; пункт,
 * добавляемый в шаблоны, однажды забывают в одном из них.
 *
 * Инварианты, закодированные здесь (`CLAUDE.md`, раздел «Рендеринг»):
 *   - меню печатается СЕРВЕРОМ: ни `client:*`, ни `<script>`, ни раскрывающихся
 *     панелей на JS. При отключённом JS меню работает полностью;
 *   - навигация — только `<a href>` с путём от корня. Ни `href="#"`, ни
 *     обработчиков, ни hash-маршрутов;
 *   - пункты ведут только на СТАТИЧЕСКИЕ маршруты (`/`, `/otkrytki`,
 *     `/podborki`). Пункт, ведущий на запись CMS, однажды повёл бы на
 *     неопубликованную страницу, то есть на 404, а меню обязано вести на 200.
 *     Список групп праздников и адресатов печатает сам каталог `/podborki`: он
 *     читает записи и выводит только опубликованные.
 *
 * Про текущий пункт: он остаётся ССЫЛКОЙ и получает `aria-current="page"`. Это
 * глобальная навигация, а не крошки — в крошках ссылки на текущую страницу нет
 * по правилу ТЗ §7.6, а в меню её отсутствие ломало бы одинаковый набор пунктов
 * на всех страницах.
 *
 * Состав пунктов — `../seo/catalog-pages.ts`: там же лежат H1 каталогов, поэтому
 * текст пункта и заголовок целевой страницы — одно значение, а не два совпадающих.
 */
import { SITE_NAV } from '../seo/catalog-pages';

interface Props {
  /**
   * Канонический путь текущей страницы. Приходит из того же пропа layout'а, из
   * которого собирается self-canonical, — второго источника «где мы находимся»
   * в разметке нет.
   */
  currentPath: string;
}

const { currentPath } = Astro.props;
---

<nav class="site-nav" aria-label="Основная навигация">
  <ul class="site-nav__list">
    {
      SITE_NAV.map((link) => (
        <li>
          <a
            class="site-nav__link"
            href={link.path}
            aria-current={link.path === currentPath ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
