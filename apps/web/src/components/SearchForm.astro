---
/**
 * Форма внутреннего поиска (задача Э3-10).
 *
 * Обычная HTML-форма с `method="get"`: браузер сам собирает `?q=`, сервер сам
 * ищет и печатает результат ссылками. Клиентского JS здесь нет ни строки — это
 * условие «страница полноценна при отключённом JS» (`CLAUDE.md`, «Рендеринг»), а
 * поисковый каркас на JS означал бы содержание за JavaScript, то есть прямой
 * запрет п. 23.
 *
 * Форма не создаёт адресов: она ведёт на ЕДИНСТВЕННЫЙ маршрут `/search`, у
 * которого canonical всегда чистый (`../seo/search-page.ts`). Метода `post`
 * здесь быть не может — тогда результат нельзя было бы открыть по ссылке и
 * показать назад кнопкой браузера.
 */
import {
  SEARCH_MAX_QUERY_LENGTH,
  SEARCH_PAGE,
  SEARCH_PATH,
  SEARCH_QUERY_PARAM,
} from '../seo/search-page';

interface Props {
  /**
   * Текущий запрос — подставляется в поле, чтобы его можно было уточнить, а не
   * набирать заново. `null` — поле пустое.
   */
  query?: string | null;
  /**
   * Идентификатор поля. Разный на разных страницах не нужен, но форма может
   * появиться дважды на одной странице — тогда `id` обязан различаться, иначе
   * подпись `<label>` укажет не на то поле.
   */
  fieldId?: string;
}

const { fieldId = 'site-search-query', query = null } = Astro.props;
---

<form class="search-form" action={SEARCH_PATH} method="get" role="search">
  <label class="search-form__label" for={fieldId}>{SEARCH_PAGE.fieldLabel}</label>
  <input
    class="search-form__input"
    id={fieldId}
    type="search"
    name={SEARCH_QUERY_PARAM}
    value={query ?? ''}
    placeholder={SEARCH_PAGE.placeholder}
    maxlength={SEARCH_MAX_QUERY_LENGTH}
    autocomplete="off"
  />
  <button class="search-form__submit" type="submit">{SEARCH_PAGE.submitLabel}</button>
</form>

<style>
  /* Поле — адресная линейка открытки: подчёркивание вместо коробки. Метка над
     полем набрана служебным начертанием, как надпись «Кому» на бланке. */
  .search-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.5rem;
    margin-block: 1.25rem 0;
  }

  .search-form__label {
    flex: 0 0 100%;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .search-form__input {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 0.4375rem 0.125rem;
    border: 0;
    border-block-end: 2px solid var(--ink);
    background: transparent;
    color: inherit;
    font: inherit;
  }

  .search-form__input::placeholder {
    color: var(--ink-faint);
  }

  /* Единственная закрашенная кнопка на сайте — акцент израсходован здесь.
     При наведении фон уходит в чернильный, а не светлеет фильтром: фильтр в
     тёмной теме дал бы почти белую заливку. */
  .search-form__submit {
    padding: 0.5rem 1.125rem;
    border: 0;
    background: var(--stamp);
    color: var(--paper-raised);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .search-form__submit:hover {
    background: var(--ink);
  }

  /* Фокусное кольцо у закрашенной кнопки — чернильное, а не акцентное: акцент
     по акценту почти не читается, между кольцом и заливкой всего 2 px. */
  .search-form__submit:focus-visible {
    outline-color: var(--ink);
  }
</style>
