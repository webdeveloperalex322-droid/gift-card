---
/**
 * Один фрагмент текста вводного блока: выделение тегами, вложенными снаружи
 * внутрь (задача Э3-06).
 *
 * Компонент рекурсивный (`Astro.self`), и это единственный способ получить
 * вложенность произвольной глубины БЕЗ склейки строки HTML: цепочка
 * `<strong><em>слово</em></strong>` собирается тегами, а сам текст печатает
 * шаблонизатор — то есть экранирует его он же. Ни `set:html`, ни
 * `innerHTML` в этом пути нет, поэтому текст, введённый человеком, не может
 * закрыть тег.
 *
 * Порядок тегов задаёт чистый разбор (`../seo/rich-text.ts`), а не этот
 * компонент: у одного и того же выделения обязана быть одна и та же разметка.
 */
interface Props {
  /** Теги выделения снаружи внутрь. Пустой массив — печатается только текст. */
  tags: readonly string[];
  text: string;
}

const { tags, text } = Astro.props;

const [outer, ...rest] = tags;
// Имя с большой буквы — так Astro понимает, что это динамический тег, а не
// литеральный элемент `<tag>`. Набор имён закрыт разбором, произвольная строка
// сюда не приходит.
const Tag = outer;
---

{Tag === undefined ? text : <Tag><Astro.self tags={rest} text={text} /></Tag>}
