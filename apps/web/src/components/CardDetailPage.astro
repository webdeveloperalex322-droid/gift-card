---
import type { Card } from '@otkritka/cms/types';

import type { CardPageContent, CatalogSection } from '../data';
import type { BreadcrumbTrail } from '../seo/breadcrumbs';
import { canonicalUrlFor } from '../routing/canonical';
import { jsonLdScriptText } from '../seo/json-ld';
import { shareTargets } from '../seo/share';
import { serverEnv } from '../server-env';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CardGrid from './CardGrid.astro';
import CardImage from './CardImage.astro';

interface Props {
  card: Card;
  /** Категории бокового меню (`./SiteSidebar.astro`) — см. `../data/site-nav.ts`. */
  categorySections: readonly CatalogSection[];
  content: CardPageContent;
  trail: BreadcrumbTrail;
}

const { card, categorySections, content, trail } = Astro.props;
const shares = shareTargets({
  title: content.heading,
  url: canonicalUrlFor(content.canonicalPath, serverEnv()),
});
const jsonLd = jsonLdScriptText(content.jsonLd);
---

<BaseLayout
  title={content.title}
  description={content.metaDescription}
  canonicalPath={content.canonicalPath}
  robots={content.robots}
  categorySections={categorySections}
>
  <Breadcrumbs trail={trail} />
  <h1>{content.heading}</h1>

  {/* Разворот: изображение и всё, что нужно для действия с ним (описание,
      скачивание, подборки, поделиться), на одном экране. От 60rem — две
      колонки; ширина колонки изображения согласована с набором sizes роли
      content-width (../images/card-image.ts). */}
  <div class="card__spread">
  <figure class="card__figure">
    <CardImage card={card} layout="content-width" priority />
    {content.caption === null ? null : <figcaption>{content.caption}</figcaption>}
  </figure>

  <div class="card__details">
  {content.description === null ? null : <p class="card__description">{content.description}</p>}

  <p class="card__download">
    <a href={content.downloadPath} download>Скачать открытку</a>
    <span class="card__download-note"> JPEG, {content.downloadWidth}×{content.downloadHeight} пикселей</span>
  </p>

  {content.attributes.length === 0 ? null : (
    <section class="page-section">
      <h2>Открытка входит в подборки</h2>
      <ul class="link-row">
        {content.attributes.map((attribute) => (
          <li><span class="card__attribute-kind">{attribute.kindLabel}:</span>{' '}<a href={attribute.path}>{attribute.name}</a></li>
        ))}
      </ul>
    </section>
  )}

  <section class="page-section">
    <h2>Поделиться</h2>
    <ul class="link-row">
      {shares.map((share) => (
        <li><a href={share.href} rel="nofollow noopener" target="_blank">{share.label}</a></li>
      ))}
    </ul>
  </section>
  </div>
  </div>

  {content.aiDisclosure === null && content.usageTerms === null ? null : (
    <section class="page-section">
      <h2>Об изображении</h2>
      {content.aiDisclosure === null ? null : <p>{content.aiDisclosure}</p>}
      {content.usageTerms === null ? null : <p>{content.usageTerms}</p>}
    </section>
  )}

  {content.similar.length === 0 ? null : (
    <section class="page-section">
      <h2>Похожие открытки</h2>
      <CardGrid tiles={content.similar} ariaLabel="Похожие открытки" />
    </section>
  )}

  <script type="application/ld+json" is:inline set:html={jsonLd} />
</BaseLayout>

<style>
  .card__spread {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  /* Порог 60rem — тот же, что у набора sizes роли content-width: от него колонка
     изображения равна 34rem, ниже изображение занимает всю колонку контента. */
  @media (min-width: 60rem) {
    .card__spread {
      grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .card__figure {
    margin: 0;
  }

  .card__description {
    margin-block: 0;
  }

  .card__description + .card__download {
    margin-block-start: 1rem;
  }

  /* В боковой колонке разделы идут плотнее и с меньшим заголовком: это
     подписи к изображению, а не самостоятельные части страницы. */
  .card__details .page-section {
    margin-block-start: 1.5rem;
  }

  .card__details h2 {
    font-size: 1rem;
    margin-block-end: 0.5rem;
  }

  /* Рамка изображения живёт в критическом CSS `../layouts/BaseLayout.astro`,
     а не здесь: scoped-стиль компонента до элементов picture и img не достаёт —
     их печатает `CardImage.astro`, и атрибута области видимости этого компонента
     они не несут. */

  .card__figure figcaption {
    max-width: 28em;
    margin-block-start: 0.75rem;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .card__download {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.875rem;
    margin-block: 1.25rem 0;
  }

  .card__download > a {
    padding: 0.5rem 1.125rem;
    background: var(--stamp);
    color: var(--paper-raised);
    font-weight: 500;
    text-decoration: none;
  }

  .card__download > a:hover {
    background: var(--ink);
  }

  .card__download > a:focus-visible {
    outline-color: var(--ink);
  }

  .card__download-note {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .card__attribute-kind {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
</style>
