---
/**
 * Сетка превью открыток (задачи Э3-06, Э3-05: блок «Похожие открытки»).
 *
 * Компонент — ТОЛЬКО представление: он не читает CMS, ничего не выбирает и не
 * вычисляет ни адресов, ни заголовков. Плитки приходят готовыми из слоя данных
 * (`../data/page-data.ts`), и это ТОТ ЖЕ массив объектов, из которого собран
 * `ItemList` в разметке JSON-LD. Соответствие «разметка = видимая сетка» держится
 * поэтому на одном значении, а не на дисциплине двух шаблонов: чтобы `href`
 * ссылки разошёлся с `url` элемента разметки, пришлось бы передать в компонент
 * другой массив.
 *
 * Инварианты, закодированные здесь (`CLAUDE.md`, разделы «Рендеринг» и
 * «Изображения»; ТЗ §5.3, §6.5):
 *   - сетка печатается НА СЕРВЕРЕ: ни `client:*`, ни `<script>`. Плитки и их
 *     изображения видны при отключённом JS;
 *   - переход на карточку — обычная `<a href>` с путём от корня. Ни
 *     обработчиков, ни `href="#"`, ни hash-маршрутов;
 *   - `sizes` изображений задаёт роль `grid-tile`, а CSS сетки живёт в
 *     критическом CSS layout'а. Пороги в `IMAGE_LAYOUT_SIZES` посчитаны ровно для
 *     той сетки — это контракт, и менять их надо вместе;
 *   - первое крупное изображение страницы без `loading="lazy"` — проп
 *     {@link Props.prioritizeFirst}. На странице подборки LCP-кандидат — первая
 *     плитка, поэтому там проп включён; в блоке «Похожие» на карточке — нет:
 *     первое крупное изображение там уже есть, и второго `fetchpriority="high"`
 *     на странице быть не должно.
 *
 * ## Почему заголовок плитки внутри той же ссылки
 *
 * Изображение и название ведут на один адрес, а две ссылки на один адрес рядом —
 * это два элемента навигации, между которыми посетителю и краулеру нечего
 * выбирать. Название при этом обязательно: у ссылки-картинки текст берётся из
 * `alt`, а видимый текст ссылки — часть перелинковки.
 */
import type { CardTile } from '../data/page-data';
import CardImage from './CardImage.astro';

interface Props {
  /**
   * Плитки в порядке, в котором их обязана показать страница. Ни фильтрации, ни
   * сортировки, ни срезов здесь нет: и то и другое означало бы, что разметка
   * описывает не то, что видно.
   */
  tiles: readonly CardTile[];
  /**
   * Первая плитка — первое крупное изображение страницы? Знает только шаблон
   * страницы: компонент не видит, что стоит выше сетки.
   */
  prioritizeFirst?: boolean;
  /** Подпись списка для вспомогательных технологий. */
  ariaLabel?: string;
}

const { ariaLabel, prioritizeFirst, tiles } = Astro.props;
---

<ul class="card-grid" aria-label={ariaLabel}>
  {
    tiles.map((tile, index) => (
      <li class="card-grid__item">
        <a class="card-grid__link" href={tile.path}>
          <CardImage
            card={tile.image}
            layout="grid-tile"
            priority={prioritizeFirst === true && index === 0}
          />
          <span class="card-grid__title">{tile.name}</span>
        </a>
      </li>
    ))
  }
</ul>
