---
/**
 * Ряд рекламных мест (задача Э3-12).
 *
 * Норма: решение Ч-11 (два ряда по три блока — под H1 над сеткой и после
 * пагинации; заглушка и размеры из настроек в админке; место резервируется по
 * этим значениям), ТЗ §5.7 (контейнеры фиксированных размеров, реклама не
 * вызывает сдвигов макета, первый экран не занят рекламой полностью, рекламный
 * код загружается отложенно и не блокирует LCP), ТЗ §10 (CLS ниже 0,1).
 *
 * ЗАМЕЧЕНО НА astro 7.2.4, важно для любого шаблона: одиночный символ «меньше» в
 * КОММЕНТАРИИ фронтматтера ломает извлечение типов компонента — `Astro.props`
 * становится `any`, объявленный `interface Props` считается неиспользованным, и
 * `astro check` жалуется на неявный `any` в разметке, а не на комментарий.
 * Поэтому численные границы в комментариях `.astro` пишутся словами («ниже
 * 0,1»), а не знаком. Локализовано бисекцией: строка со знаком «меньше» и числом
 * в этой шапке давала три ts-ошибки, та же строка словом — ноль. Парная
 * последовательность вида тега (`<script>`) при этом безобидна: ломает именно
 * одиночный знак.
 *
 * ## Что этот компонент делает и чего не делает
 *
 * Делает: печатает зарезервированные коробки по размерам из глобала. Ряд —
 * ГОРИЗОНТАЛЬНЫЙ: высота ряда равна высоте самого высокого блока, а не сумме
 * (обоснование — `../seo/ad-slots.ts`, `adRowReservedHeight`).
 *
 * Не делает: не подключает рекламную сеть. Кода сети нет, потому что нет и
 * решения о ней (Ч-11 в этой части открыт человеком). До него на месте блока
 * стоит ЗАГЛУШКА, и в разметке нет ни одного внешнего `<script>`, ни `<iframe>`,
 * ни запроса в чужой домен — а значит, рекламный код не может ни блокировать
 * LCP, ни сдвинуть макет. Когда сеть появится, её код встанет ВНУТРЬ уже
 * зарезервированной коробки и обязан быть отложенным (`async`/`defer`), иначе
 * требование §5.7 нарушится в первый же день.
 *
 * ## Почему блок не выводится при незаполненных размерах
 *
 * Решение принимает предикат из `@otkritka/shared` (`isAdSlotRenderable`),
 * компонент его только исполняет: коробка нулевого размера зарезервировала бы
 * ноль, а появившийся в ней баннер сдвинул бы всё содержимое ниже — ровно тот
 * CLS, ради которого резерв и существует.
 *
 * Пустой ряд не печатает ВООБЩЕ НИЧЕГО: ни контейнера, ни подписи. Пустой
 * контейнер занимал бы место, отведённое под то, чего нет.
 */
import { AD_PLACEHOLDER_TEXT, AD_ROW_LABELS, type AdPlaceholder } from '../seo/ad-slots';

interface Props {
  /** Готовый ряд из `../seo/ad-slots.ts`. Пустой — компонент молчит. */
  slots: readonly AdPlaceholder[];
  /**
   * Позиция ряда: от неё зависит только видимая подпись.
   *
   * Тип берётся из ключей таблицы подписей: она объявлена как
   * `Record<AdSlotPosition, string>` в `../seo/ad-slots.ts`, поэтому набор
   * значений тот же, а новая позиция обязана появиться и здесь. Импорт типа
   * `AdSlotPosition` прямо в шаблон работал бы тоже — причина прежней ошибки
   * типов была не в нём (см. шапку про символ «меньше»).
   */
  position: keyof typeof AD_ROW_LABELS;
}

const { position, slots } = Astro.props;
---

{
  slots.length === 0 ? null : (
    <aside class="ad-row" aria-label={AD_ROW_LABELS[position]}>
      {
        slots.map((slot) => (
          <div class="ad-row__slot" style={slot.style}>
            <span class="ad-row__stub">{AD_PLACEHOLDER_TEXT}</span>
          </div>
        ))
      }
    </aside>
  )
}

<style>
  /* Ряд горизонтальный: высота ряда — высота самого высокого блока, а не сумма.
     Три блока в столбик заняли бы первый экран целиком (запрет ТЗ §5.7). */
  .ad-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.75rem;
    margin-block: 1rem;
  }

  /* Место резервируется ПРОПОРЦИЕЙ и предельной шириной, а не жёсткой высотой:
     на узком экране коробка сжимается вместе с колонкой, поэтому
     зарезервированное место совпадает с занятым при любой ширине. Обе величины
     приходят из админки инлайновыми переменными (`--ad-width`, `--ad-ratio`) —
     файл стилей о них знать не может. */
  .ad-row__slot {
    flex: 1 1 var(--ad-width, 300px);
    max-width: var(--ad-width, 300px);
    aspect-ratio: var(--ad-ratio, 300 / 250);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed currentColor;
    border-radius: 0.25rem;
    opacity: 0.55;
  }

  .ad-row__stub {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
