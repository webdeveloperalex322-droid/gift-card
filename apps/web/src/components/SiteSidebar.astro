---
/**
 * Боковое меню категорий открыток — рельс слева на широком экране, раскрывающееся
 * меню-«бургер» на узком.
 *
 * Печатается на КАЖДОЙ странице, кроме 404, из `../layouts/BaseLayout.astro` —
 * причина та же, что у `SiteNav.astro`: «страница входит в навигацию» (п. 5.1 ТЗ)
 * нельзя обеспечивать по одному шаблону из полутора десятков. Состав узлов даёт
 * `../data/site-nav.ts` (`siteCategoryNav`) — то же дерево «корень + прямые дети»,
 * что и внутристраничный блок каталога, отобранное тем же условием «непусто».
 *
 * ## Ноль клиентского JS, и переключатель тем не менее РАБОТАЕТ
 *
 * Раскрытие на узком экране — нативный чекбокс + `<label for>`: НЕ директива
 * `client:*`, не `<script>`, не JS-обработчик клика. Правило `BaseLayout.astro`
 * («ни раскрывающихся панелей НА JS») запрещает панель, которую открывает скрипт;
 * панель, которую открывает нажатие на элемент формы и раскрывает чистый CSS
 * (`:checked ~ .sidebar__panel`), под запрет не подпадает — она часть HTML, а не
 * поведение, добавленное после загрузки. При отключённом JS работает без разницы:
 * чекбокс — нативный элемент управления.
 *
 * На УЗКОМ экране чекбокс скрыт классическим приёмом «visually-hidden» (не
 * `display: none` и не `visibility: hidden` — оба убрали бы элемент из очерёдности
 * табуляции и из дерева доступности), поэтому остаётся доступен с клавиатуры и
 * скринридеру. Видимую кнопку рисует `<label>`, фокусное кольцо переносится на неё
 * смежным селектором `:focus-visible ~`.
 *
 * На ШИРОКОМ (от 66rem, где рельс открыт всегда) критический CSS ставит чекбоксу
 * именно `display: none` — и это не противоречие предыдущему абзацу, а его
 * продолжение: там переключать нечего, и элемент управления без эффекта только
 * занимал бы место в табуляции, притом без видимого индикатора фокуса (подпись,
 * на которую кольцо переносится, там тоже скрыта).
 *
 * ## На узком экране панель свёрнута ПО УМОЛЧАНИЮ — это не нарушает п. 5.1
 *
 * До нажатия на `<label>` ссылки категорий на узком экране в отрендеренной
 * раскладке не видны (`.sidebar__panel { display: none }` — открывает только
 * `:checked ~`). Условие «страница входит в навигацию» (п. 5.1 ТЗ) это не
 * нарушает: сами ссылки — обычные `<a href>` в HTML-ответе сервера, а не в
 * значении, добавленном скриптом, и обход по ссылкам (в т.ч. поисковым роботом)
 * их видит независимо от текущего состояния `:checked` — так же, как любое
 * `<details>` или мобильное меню-«гамбургер» на любом сайте не выпадает из
 * индексации оттого, что свёрнуто по умолчанию. Достижимость карточек за первой
 * страницей списка (обязательное требование Ч-04-8) при этом держится не на
 * рельсе, а на внутристраничных блоках перелинковки каталога и подборки — рельс
 * им не замена, а дополнительный путь навигации для человека.
 *
 * ## Почему рельс, а не список ссылок в верхнем меню
 *
 * Категорий на сайте — праздники и адресаты, каждый с детьми, — больше, чем
 * влезает горизонтальной строкой без переноса на несколько рядов (тот приём уже
 * есть у `SiteNav.astro` для трёх пунктов и не масштабируется на дерево). Левый
 * рельс — стандартное решение для дерева категорий и не спорит с направлением
 * «Почтовый штемпель»: ни скруглений, ни новых цветов, состояние — линией и
 * цветом одновременно, как у `SiteNav.astro` (`aria-current` + `border`).
 */
import type { CatalogSection } from '../data';

interface Props {
  /** Корневые узлы и их прямые дети. Пустой массив — меню нет вовсе (нечего показывать). */
  categorySections: readonly CatalogSection[];
  /** Путь текущей страницы либо `null` (404 сюда не попадает — своего рельса не получает). */
  currentPath: string | null;
}

const { categorySections, currentPath } = Astro.props;
---

{
  categorySections.length === 0 ? null : (
    <div class="sidebar">
      <input type="checkbox" id="sidebar-toggle" class="sidebar__checkbox" />
      <label class="sidebar__toggle" for="sidebar-toggle">
        <svg
          class="sidebar__burger"
          width="20"
          height="20"
          viewBox="0 0 20 20"
          aria-hidden="true"
          focusable="false"
        >
          <line class="sidebar__burger-line sidebar__burger-line--top" x1="2" y1="5" x2="18" y2="5" />
          <line class="sidebar__burger-line sidebar__burger-line--mid" x1="2" y1="10" x2="18" y2="10" />
          <line class="sidebar__burger-line sidebar__burger-line--bot" x1="2" y1="15" x2="18" y2="15" />
        </svg>
        Категории
      </label>
      <nav class="sidebar__panel" aria-label="Категории открыток">
        <ul class="sidebar__groups">
          {categorySections.map((section) => (
            <li class="sidebar__group">
              <a
                class="sidebar__group-link"
                href={section.node.path}
                aria-current={section.node.path === currentPath ? 'page' : undefined}
              >
                {section.node.name}
              </a>
              {section.children.length === 0 ? null : (
                <ul class="sidebar__children">
                  {section.children.map((child) => (
                    <li>
                      <a
                        class="sidebar__child-link"
                        href={child.path}
                        aria-current={child.path === currentPath ? 'page' : undefined}
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}
