---
/**
 * Изображение открытки: `<picture>` с источниками AVIF/WebP и резервным `<img>`
 * (задача Э3-04).
 *
 * Компонент — ТОЛЬКО печать атрибутов. Запросов он не делает и записи CMS не
 * читает: модель приходит готовой из слоя данных (`../data/card-image.ts`,
 * функция `cardPictureModel`), а правила разметки живут в чистом модуле
 * `../images/card-image.ts`. Причина не в чистоте стиля: шаблон, который сам
 * ходит в CMS, однажды сходит туда без параметров прав анонима, и разница будет
 * видна не в сборке, а в индексе.
 *
 * Инварианты, закодированные здесь (`CLAUDE.md`, разделы «Изображения» и
 * «Рендеринг»; ТЗ §6.5, §10):
 *   - разметка печатается НА СЕРВЕРЕ: ни `client:*`, ни `<script>`, ни
 *     `data-`-атрибутов под скрипт. Изображение видно при отключённом JS;
 *   - `src` реальный, `srcset` и `sizes` заданы, `width` и `height` обязательны
 *     — место резервируется до загрузки файла, поэтому сдвига макета нет;
 *   - у первого крупного изображения атрибута `loading` НЕТ (проп `priority`),
 *     у остальных — `loading="lazy"`. Дефолт безопасный: забытый проп даёт
 *     ленивую загрузку, а не второго кандидата на LCP;
 *   - `alt` печатается всегда: его отсутствие невыразимо типом (`ImageAlt`), а
 *     пустое описание в записи даёт отказ, а не пустой атрибут.
 *
 * ## Почему проп — ЗАПИСЬ, а не `variants` и `alt` по отдельности
 *
 * Источники и описание обязаны приходить из одной записи. Раздельные пропсы
 * делали бы выразимым `alt` одной открытки при вариантах другой — на странице
 * оказалось бы описание не той картинки, и ни типы, ни тесты этого не заметили
 * бы. С пропом-записью такое состояние не существует.
 *
 * ## Почему у компонента нет своего `<style>`
 *
 * Всё, что ему нужно, уже задано критическим CSS layout'а: `img { max-width:
 * 100%; height: auto }`. Пара `width`/`height` вместе с этим правилом и даёт
 * резерв места по пропорции. Свой блок стилей означал бы либо второй запрос за
 * CSS, либо рост критического CSS ради правила, которое уже есть. Размеры
 * КОНТЕЙНЕРА (плитки сетки, колонки карточки) задаёт шаблон, который компонент
 * размещает, — и он же обязан согласовать сетку с набором `sizes` (контракт
 * описан у `IMAGE_LAYOUT_SIZES`).
 *
 * ## Что печатается при отсутствии производных
 *
 * Ничего. `cardPictureModel` отдаёт `null` — и тогда `<picture>` не выводится
 * вовсе, а не выводится с пустым `srcset` или с заглушкой. Пустой `srcset` — это
 * атрибут, из которого браузеру нечего выбрать; заглушка — картинка, которой в
 * записи нет.
 */
import { type CardImageSource, cardPictureModel } from '../data/card-image';
import type { ImageLayout } from '../images/card-image';

interface Props {
  /**
   * Карточка: поля `alt` и `derivative.variants[]`. Передаётся запись целиком
   * (`Pick` от сгенерированного типа), а не выборка полей — см. шапку.
   */
  card: CardImageSource;
  /**
   * Роль изображения в вёрстке — от неё зависит `sizes`. Набор значений закрыт:
   * произвольную строку `sizes` шаблон задать не может, иначе её никто не
   * проверит (обоснование — `IMAGE_LAYOUT_SIZES`).
   */
  layout: ImageLayout;
  /**
   * Это первое крупное изображение страницы? Знает только шаблон: компонент не
   * видит ни порядка блоков, ни первого экрана. На странице такое изображение
   * ровно одно. Пропуск пропа = `false` (ленивая загрузка).
   */
  priority?: boolean;
}

const { card, layout, priority } = Astro.props;

const picture = cardPictureModel({ card, layout, priority });
---

{
  picture === null ? null : (
    <picture>
      {
        picture.sources.map((source) => (
          <source type={source.type} srcset={source.srcset} sizes={source.sizes} />
        ))
      }
      <img
        src={picture.img.src}
        srcset={picture.img.srcset}
        sizes={picture.img.sizes}
        width={picture.img.width}
        height={picture.img.height}
        alt={picture.img.alt}
        loading={picture.img.loading}
        fetchpriority={picture.img.fetchpriority}
      />
    </picture>
  )
}
