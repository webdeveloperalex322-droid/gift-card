---
/**
 * Подвал сайта: ссылки на служебные страницы (задача Э3-11).
 *
 * Печатается на КАЖДОЙ странице — из `../layouts/BaseLayout.astro`, по той же
 * причине, что и главное меню (`./SiteNav.astro`): «страница входит в навигацию»
 * — одно из условий п. 5.1 ТЗ, и выполнять его по одному шаблону из шести
 * нельзя. Служебные страницы попадают в подвал, а не в верхнее меню, чтобы не
 * отнимать место у каталогов, ради которых меню и существует; условие при этом
 * выполнено так же строго — подвал есть на всех страницах, включая 404.
 *
 * Инварианты (`CLAUDE.md`, раздел «Рендеринг»):
 *   - подвал печатает СЕРВЕР: ни `client:*`, ни `<script>`;
 *   - навигация — только `<a href>` с путём от корня;
 *   - все три адреса отвечают 200 всегда, даже пока текст не заполнен
 *     (обоснование — шапка `../seo/info-pages.ts`), поэтому ссылки на 404 здесь
 *     не бывает.
 *
 * Состав ссылок — `../seo/info-pages.ts` (`INFO_PAGE_NAV`); пути приходят из
 * реестра `@otkritka/shared`, второй копии адресов в шаблоне нет.
 */
import { INFO_PAGE_NAV } from '../seo/info-pages';

interface Props {
  /**
   * Канонический путь текущей страницы либо `null` (страница без канонического
   * адреса — 404). Нужен только для `aria-current`, поэтому `null` означает
   * «ни один пункт не текущий», а не ошибку.
   */
  currentPath: string | null;
}

const { currentPath } = Astro.props;
---

<footer class="site-footer">
  <nav aria-label="Служебные страницы">
    <ul class="link-row">
      {
        INFO_PAGE_NAV.map((link) => (
          <li>
            <a
              href={link.path}
              aria-current={link.path === currentPath ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</footer>
