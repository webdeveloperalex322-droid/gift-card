---
/**
 * Страница каталога открыток — общая разметка `/otkrytki` и `/otkrytki/page/N`
 * (задачи Э3-07, Э3-08).
 *
 * Компонент существует ровно потому, что каталог отдают ДВА маршрута, а страница
 * у них одна. Разложить разметку по двум шаблонам значило бы, что первая страница
 * и страницы пагинации однажды разойдутся в составе блоков — например, на второй
 * странице потеряются крошки или второй раз появится `fetchpriority="high"`.
 * Решение (что показывать и какой ответ дать) принимает `../data/catalog.ts`, здесь
 * только вывод.
 *
 * Инварианты, закодированные здесь (`CLAUDE.md`, разделы «Рендеринг» и
 * «Изображения»):
 *   - **ровно один `<h1>`** — заголовок страницы из `catalogPageView`, уже с
 *     номером страницы на страницах 2+;
 *   - **первое крупное изображение одно** — первая плитка сетки
 *     (`prioritizeFirst`); выше сетки на странице ничего крупнее нет;
 *   - **ноль клиентского JS**, навигация только `<a href>`;
 *   - **self-canonical и директива робота** приходят готовыми: у страницы
 *     пагинации canonical указывает на неё саму, а директива — `noindex,follow`
 *     (решение Ч-01b);
 *   - **рекламные ряды** (Ч-11, задача Э3-12): под H1 над сеткой и после
 *     пагинации. Ряд под H1 стоит ПОСЛЕ вводного абзаца — «под H1, над сеткой» по
 *     Ч-11 и «первый экран не занят рекламой полностью» по ТЗ §5.7 выполняются
 *     оба только в этом порядке. Незаполненные места не печатаются вовсе
 *     (`../seo/ad-slots.ts`).
 */
import AdRow from './AdRow.astro';
import CardGrid from './CardGrid.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Pagination from './Pagination.astro';
import type { CardCatalogBody } from '../data';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATALOGS } from '../seo/catalog-pages';
import { jsonLdScriptText } from '../seo/json-ld';

interface Props {
  /** Готовое содержимое страницы из `../data/catalog.ts`. */
  body: CardCatalogBody;
}

const { body } = Astro.props;
const facts = CATALOGS.cards;
const jsonLd = jsonLdScriptText(body.jsonLd);
---

<BaseLayout
  title={body.view.title}
  description={body.view.metaDescription}
  canonicalPath={body.view.canonicalPath}
  robots={body.view.robots}
>
  <Breadcrumbs trail={body.trail} />

  <h1>{body.view.heading}</h1>

  {
    /* Вводный абзац — только на первой странице: тот же текст на каждой странице
       списка означал бы одно содержание по нескольким адресам. */
    body.page === 1 ? <p class="catalog__lead">{facts.lead}</p> : null
  }

  <AdRow slots={body.ads.underH1} position="under-h1" />

  <CardGrid tiles={body.tiles} prioritizeFirst ariaLabel={facts.listLabel} />

  {body.pagination === null ? null : <Pagination model={body.pagination} />}

  <AdRow slots={body.ads.afterPagination} position="after-pagination" />

  <script type="application/ld+json" is:inline set:html={jsonLd} />
</BaseLayout>

<style>
  .catalog__lead {
    max-width: 45rem;
    margin-block: 0 1.25rem;
  }
</style>
