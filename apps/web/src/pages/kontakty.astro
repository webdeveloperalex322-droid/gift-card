---
/**
 * «Контакты» — `/kontakty` (задача Э3-11).
 *
 * Норма: ТЗ §5.6, решения Ч-19 и Ч-23. Путь занят в реестре зарезервированных
 * маршрутов целиком: статический маршрут Astro, не запись CMS.
 *
 * Контактных данных в разметке этой страницы НЕТ намеренно. Телефон и почта живут
 * в глобале настроек и попадают в JSON-LD `Organization` на главной (решение
 * Ч-17, задача Э3-09) — там у них есть тип и контекст. Продублировать их здесь
 * вторым блоком разметки значило бы завести второй источник одних и тех же
 * значений; видимый текст страницы пишет человек, и он вправе указать в нём то,
 * что считает нужным.
 */
import InfoPageView from '../components/InfoPageView.astro';
import { infoPage } from '../data';

export const prerender = false;

const view = await infoPage('contacts');
---

<InfoPageView view={view} />
