---
/**
 * «Условия использования» — `/usloviya` (задача Э3-11).
 *
 * Норма: ТЗ §5.6, решения Ч-19, Ч-23 и Ч-10. Путь занят в реестре
 * зарезервированных маршрутов целиком: статический маршрут Astro, не запись CMS.
 *
 * Особая роль среди трёх служебных страниц. На этот адрес ссылается РАЗМЕТКА
 * КАРТОЧКИ — свойства `license` и `acquireLicensePage` объекта `ImageObject`
 * (решение Ч-10, значения приходят из глобала настроек). Отсюда и решение, что
 * незаполненная служебная страница отдаёт 200 с заглушкой, а не 404: лицензионная
 * ссылка, ведущая на 404, хуже честной заглушки — это юридическая отсылка, и её
 * обрыв виден и человеку, и потребителю разметки. Полное обоснование — шапка
 * `../seo/info-pages.ts`.
 *
 * Ссылка отсюда доводом за индексацию НЕ является: она работает и на
 * неиндексируемой странице (прямая формулировка решения Ч-23). Директиву робота
 * по-прежнему определяет предикат: выключатель человека И реальный текст.
 */
import InfoPageView from '../components/InfoPageView.astro';
import { infoPage } from '../data';

export const prerender = false;

const view = await infoPage('terms');
---

<InfoPageView view={view} />
