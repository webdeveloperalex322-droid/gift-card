---
/**
 * Главная страница — `/` (задача Э3-09).
 *
 * Норма: ТЗ §5.2 (заголовок и вводный блок с уникальным текстом; блоки
 * «актуальные праздничные подборки», «популярные разделы», «свежие открытки»;
 * сезонные блоки управляются датами из админки; JSON-LD `WebSite` +
 * `Organization`), решение Ч-17 (при незаполненном глобале блок `Organization`
 * не выводится вовсе), следствие Ч-04-5 (прямые ссылки с главной на праздничные
 * узлы), `CLAUDE.md` — разделы «Рендеринг», «Правила индексации»,
 * «Структурированные данные».
 *
 * До этой задачи по адресу стояла техническая заглушка Э3-01.
 *
 * ## Почему маршрут SSR, а не пререндер
 *
 * Критерий готовности задачи: сезонный блок переключается по датам из CMS БЕЗ
 * ПЕРЕСБОРКИ. Пререндер зафиксировал бы и состав блока, и день, на который он
 * собран, в артефакте — «управление из админки» превратилось бы в «управление
 * деплоем». Поэтому `prerender = false`, а день берётся на запросе и передаётся
 * аргументом (`homePage(new Date())`).
 *
 * ## Инварианты, закодированные здесь
 *
 *   - **ровно один `<h1>`** — заголовок из `HOME_PAGE`; заголовки блоков `<h2>`;
 *   - **весь текст и все ссылки — в ответе сервера**, ноль клиентского JS,
 *     навигация только `<a href>`;
 *   - **первое крупное изображение одно** — первая плитка блока свежих открыток
 *     (`prioritizeFirst`); выше на странице изображений нет;
 *   - **ссылки только на опубликованные записи**: сезонные подборки, разделы и
 *     открытки приходят из слоя данных, а он читает правами анонима. Статических
 *     ссылок на узлы таксономии в коде нет — узел может быть не опубликован, и
 *     вписанная ссылка вела бы на 404 (то же правило, что у меню на Э3-08);
 *   - **`noindex,follow`** — открыть главную в индекс может только человек.
 *
 * ## Почему блок, для которого нет данных, не печатается
 *
 * Заголовок «Подборки к ближайшим праздникам» над пустым местом — обещание,
 * которого страница не выполняет. Пока сезонных подборок нет, блока нет вовсе;
 * то же у разделов и у свежих открыток. Сама страница при этом отвечает 200
 * всегда: у главной, в отличие от списка, содержание не сводится к записям
 * (обоснование — шапка `../data/home.ts`).
 *
 * ## Чего на странице нет и почему
 *
 * Рекламных мест (Ч-11): решение называет две позиции — под H1 над сеткой и
 * после пагинации, — и обе привязаны к странице СПИСКА с пагинацией. У главной
 * пагинации нет, поэтому вторая позиция здесь неопределима, а ставить рекламу
 * по собственному разумению агент не будет: место рекламы на главной — решение
 * человека (вынесено в отчёт задачи Э3-12).
 */
import CardGrid from '../components/CardGrid.astro';
import SearchForm from '../components/SearchForm.astro';
import StampMark from '../components/StampMark.astro';
import { homePage } from '../data';
import BaseLayout from '../layouts/BaseLayout.astro';
import { HOME_PAGE } from '../seo/home-page';
import { jsonLdScriptText } from '../seo/json-ld';
import { serverEnv } from '../server-env';

export const prerender = false;

const content = await homePage(new Date(), serverEnv());
const jsonLd = jsonLdScriptText(content.jsonLd);
---

<BaseLayout
  title={content.view.title}
  description={content.view.metaDescription}
  canonicalPath={content.view.canonicalPath}
  robots={content.view.robots}
>
  {/* Герой — обратная сторона открытки: бумажный лист, оттиск штемпеля в углу,
      заголовок и поиск на нём. Это оформление, а не структура: внутри тот же
      единственный `<h1>`, тот же вводный текст и та же форма поиска, что были
      до направления «Почтовый штемпель». Оттиск помечен `aria-hidden`, потому
      что содержания не несёт. */}
  <div class="hero">
    <StampMark class="hero__mark" size={96} />

    <h1>{content.view.heading}</h1>

    <div class="home__lead">
      {content.lead.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {/* Форма поиска (Э3-10): обычная HTML-форма с method="get", ноль клиентского
        JS. Она ведёт на единственный маршрут /search с чистым canonical и второго
        адреса главной не создаёт. */}
    <SearchForm fieldId="home-search-query" />
  </div>

  {
    content.seasonal.length === 0 ? null : (
      <nav class="page-section" aria-label={HOME_PAGE.seasonal.listLabel}>
        <h2>{HOME_PAGE.seasonal.heading}</h2>
        <ul class="home__stamps">
          {
            content.seasonal.map((link) => (
              <li>
                <a href={link.path}>{link.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    )
  }

  {
    content.sections.length === 0 ? null : (
      <nav class="page-section" aria-label={HOME_PAGE.sections.listLabel}>
        <h2>{HOME_PAGE.sections.heading}</h2>
        <ul class="home__sections">
          {
            content.sections.map((section) => (
              <li class="home__section">
                <h3 class="home__section-title">
                  <a href={section.node.path}>{section.node.name}</a>
                </h3>
                {
                  section.children.length === 0 ? null : (
                    <ul class="link-row">
                      {
                        section.children.map((child) => (
                          <li>
                            <a href={child.path}>{child.name}</a>
                          </li>
                        ))
                      }
                    </ul>
                  )
                }
              </li>
            ))
          }
        </ul>
      </nav>
    )
  }

  {
    content.recent.length === 0 ? null : (
      <section class="page-section">
        <h2>{HOME_PAGE.recent.heading}</h2>
        <CardGrid
          tiles={content.recent}
          prioritizeFirst
          ariaLabel={HOME_PAGE.recent.listLabel}
        />
      </section>
    )
  }

  <script type="application/ld+json" is:inline set:html={jsonLd} />
</BaseLayout>

<style>
  .home__lead {
    max-width: 45rem;
    color: var(--ink-soft);
  }

  .home__lead > p {
    margin-block: 0 0.75rem;
  }

  /* Сезонные подборки — марки с зубцовкой: второй характерный предмет
     почтового направления после штемпеля. */
  .home__stamps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home__stamps a {
    position: relative;
    /* Свой контекст наложения: подложка уходит под текст ссылки, но НЕ под
       фон родителя. */
    isolation: isolate;
    display: block;
    padding: 0.625rem 0.8125rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  /* Зубцовка вырезана маской из четырёх слоёв и висит на `::before`, а не на
     самой ссылке. Причина: маска обрезает ВСЮ отрисовку элемента, а `outline`
     рисуется вне border-box — на фокусируемой ссылке маска срезала бы видимое
     фокусное кольцо, то есть ломала бы навигацию с клавиатуры.

     Там, где браузер не понимает `mask-composite`, четыре слоя складываются в
     объединение и марка остаётся обычным прямоугольником. Это осознанная
     деградация: ни один вариант не даёт «дырявого» блока с пропавшим текстом. */
  .home__stamps a::before {
    --stamp-perf-dot: 4px;
    --stamp-perf-step: 11px;

    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper-sunken);
    -webkit-mask:
      radial-gradient(var(--stamp-perf-dot) at 50% 0, #0000 98%, #000) 0 0 /
        var(--stamp-perf-step) 100%,
      radial-gradient(var(--stamp-perf-dot) at 50% 100%, #0000 98%, #000) 0 100% /
        var(--stamp-perf-step) 100%,
      radial-gradient(var(--stamp-perf-dot) at 0 50%, #0000 98%, #000) 0 0 / 100%
        var(--stamp-perf-step),
      radial-gradient(var(--stamp-perf-dot) at 100% 50%, #0000 98%, #000) 100% 0 / 100%
        var(--stamp-perf-step);
    -webkit-mask-composite: source-in;
    mask:
      radial-gradient(var(--stamp-perf-dot) at 50% 0, #0000 98%, #000) 0 0 /
        var(--stamp-perf-step) 100%,
      radial-gradient(var(--stamp-perf-dot) at 50% 100%, #0000 98%, #000) 0 100% /
        var(--stamp-perf-step) 100%,
      radial-gradient(var(--stamp-perf-dot) at 0 50%, #0000 98%, #000) 0 0 / 100%
        var(--stamp-perf-step),
      radial-gradient(var(--stamp-perf-dot) at 100% 50%, #0000 98%, #000) 100% 0 / 100%
        var(--stamp-perf-step);
    mask-composite: intersect;
  }

  .home__stamps a:hover::before {
    background: var(--stamp-tint);
  }

  .home__stamps a:hover {
    color: var(--stamp);
  }

  .home__sections {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .home__section + .home__section {
    margin-block-start: 1.25rem;
  }

  .home__section-title {
    font-size: 1.0625rem;
    margin-block: 0 0.375rem;
  }
</style>
