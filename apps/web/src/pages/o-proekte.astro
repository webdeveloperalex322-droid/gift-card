---
/**
 * «О проекте» — `/o-proekte` (задача Э3-11).
 *
 * Норма: ТЗ §5.6, решения Ч-19 (текст правится в админке) и Ч-23 (именованное
 * исключение по индексации). Путь занят в реестре зарезервированных маршрутов
 * целиком (`packages/shared/src/reserved-routes.ts`): это СТАТИЧЕСКИЙ маршрут
 * Astro, а не запись CMS, и записи с таким итоговым путём создать нельзя.
 *
 * Маршрут SSR (`prerender = false`), потому что от запроса зависят три вещи:
 * текст (из глобала настроек в БД), директива робота (выключатель Ч-23, который
 * человек может переключить в любой момент) и абсолютный canonical (из `SITE_URL`
 * того сервера, который отвечает). Пререндер запёк бы всё три в артефакт.
 *
 * Решение и разметка — общие для трёх служебных страниц
 * (`../data/info-pages.ts`, `../components/InfoPageView.astro`). Здесь только
 * выбор страницы: три копии одного порядка вызовов однажды разошлись бы молча.
 */
import InfoPageView from '../components/InfoPageView.astro';
import { infoPage } from '../data';

export const prerender = false;

const view = await infoPage('about');
---

<InfoPageView view={view} />
