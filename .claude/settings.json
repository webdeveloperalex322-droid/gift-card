{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/seo-touch-reminder.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/finish-reminder.mjs"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm run check)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test:seo)",
      "Bash(pnpm run verify)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": []
  }
}
